{
  "name": "excalibur-project-template",
  "version": "1.2.0",
  "description": "Base project template for Excalibur.js games using Vite",
  "type": "module",
  "main": "src/main.ts",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "lint": "oxlint",
    "serve": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,js,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,css}\""
  },
  "keywords": [
    "excalibur",
    "excaliburjs",
    "vite",
    "game-engine"
  ],
  "author": "",
  "license": "BSD-2-Clause",
  "dependencies": {
    "excalibur": "0.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "prettier": "^3.8.4",
    "typescript": "^7.0.2",
    "vite": "6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
